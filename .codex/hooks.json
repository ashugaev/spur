{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/auto-push.sh",
            "statusMessage": "Auto-pushing pending changes...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": ".codex/hooks/code-simplifier.sh",
            "statusMessage": "Running code-simplifier...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
