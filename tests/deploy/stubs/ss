#!/usr/bin/env bash
# Deterministic ss stub for deploy tests.
#
# Mirrors `ss -tlnH 'sport = :PORT'`: prints a listener line iff the web
# service is "serving". Web serves iff the last verb for spur-web.service in
# $SPUR_DEPLOY_STATE is start or restart. The daemon port (:4310) is reported
# empty (kill_rogue_daemon_on_port only needs a clean box here).
set -euo pipefail

state="${SPUR_DEPLOY_STATE:?SPUR_DEPLOY_STATE must be set}"

# Find the requested port from the "sport = :PORT" filter argument.
port=""
for arg in "$@"; do
  case "$arg" in
  *:*)
    port="${arg##*:}"
    ;;
  esac
done

web_serving() {
  local last=""
  if [[ -f "$state" ]]; then
    last=$(grep -E ' spur-web\.service$' "$state" | tail -n1 | cut -d' ' -f1) || true
  fi
  [[ "$last" == "start" || "$last" == "restart" ]]
}

if [[ "$port" == "3012" ]] && web_serving; then
  echo 'LISTEN 0 511 127.0.0.1:3012 0.0.0.0:*'
fi
exit 0
