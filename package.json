{
  "name": "spur-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Spur dashboard UI plus lean v2 orchestrator",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir packages/web build && pnpm --dir v2 build",
    "dev": "pnpm --dir packages/web dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --dir packages/web typecheck && pnpm --dir v2 typecheck",
    "test": "pnpm --dir packages/web test && pnpm --dir v2 test",
    "clean": "pnpm --dir packages/web clean && pnpm --dir v2 clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky",
    "dev:auto-pull": "bash scripts/dev-autoupdate.sh",
    "start:auto-pull": "bash scripts/start-autoupdate.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.55.0"
  }
}
