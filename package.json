{
  "name": "spur-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Spur daemon and CLI with an optional web UI",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir packages/web build && pnpm --dir v2 build",
    "dev": "pnpm --dir packages/web dev",
    "ui:build": "pnpm --dir packages/web build",
    "ui:start": "pnpm --dir packages/web start",
    "setup": "bash scripts/setup.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --dir packages/web typecheck && pnpm --dir v2 typecheck",
    "test": "pnpm --dir packages/web test && pnpm --dir v2 test",
    "test:integration": "pnpm --dir v2 test:runtime",
    "test:deploy": "bash tests/deploy/main-deploy-concurrency.test.sh",
    "clean": "pnpm --dir packages/web clean && pnpm --dir v2 clean",
    "prepare": "husky",
    "main:deploy": "bash scripts/main-deploy.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.55.0"
  },
  "pnpm": {
    "overrides": {
      "flatted": "3.4.2",
      "picomatch": "4.0.4",
      "postcss": "8.5.10",
      "rollup": "4.60.2",
      "tar": "7.5.13",
      "vite": "7.3.2"
    }
  }
}
