# Agent Orchestrator Configuration
# Copy to agent-orchestrator.yaml and customize.

# Where to store session metadata
dataDir: ~/.agent-orchestrator

# Where to create workspaces (git worktrees, clones)
worktreeDir: ~/.worktrees

# Web dashboard port
port: 3000

# Terminal server ports (defaults: 14800/14801 — chosen to avoid conflicts with dev tools)
# Override when running multiple dashboards to avoid EADDRINUSE
# terminalPort: 14800
# directTerminalPort: 14801

# Remote access (Tailscale)
# Short path for mobile HTTPS:
#   tailscale serve --bg 3000
# Then `ao dashboard` will print https://<your-node>.ts.net/
# remote:
#   tailscaleHost: auto  # prefer tailscale serve https URL, then MagicDNS/IP fallback

# Default plugins (these are the defaults — you can omit this section)
defaults:
  runtime: tmux # tmux | process | docker | kubernetes | ssh | e2b
  agent: claude-code # claude-code | codex | aider | goose | custom
  workspace: worktree # worktree | clone | copy
  notifiers: [desktop] # desktop | slack | telegram | discord | webhook | email

# Projects — at minimum, specify repo and path
projects:
  my-app:
    name: My App
    repo: org/my-app
    path: ~/my-app
    defaultBranch: main
    sessionPrefix: app

    # Issue tracker (defaults to github issues)
    # tracker:
    #   plugin: linear
    #   teamId: "your-team-id"

    # Jira tracker — per-project connection config
    # tracker:
    #   plugin: jira
    #   baseUrl: "https://myorg.atlassian.net"   # falls back to JIRA_URL / JIRA_HOST env var
    #   projectKey: "INT"                         # required for listIssues / createIssue
    #   email: "you@yourorg.com"                  # falls back to JIRA_EMAIL / JIRA_USER env var
    #   apiToken: "your-api-token"               # falls back to JIRA_API_TOKEN / JIRA_TOKEN env var (prefer env var over hardcoding)
    #   pollIntervalMs: 30000                    # comment poll interval (default: 60000); falls back to AO_JIRA_POLL_INTERVAL_MS

    # Per-project trigger listeners — tracker filters and auto-spawn config lives here.
    # (Equivalent to top-level `listeners` but scoped to this project; no projectId needed.)
    # Canonical source is `tracker-task`.
    # `jql` is intentionally not supported here: it is Jira-specific and would break tracker portability.
    # Jira-specific query semantics belong inside the Jira tracker plugin, not the shared listener schema.
    # listeners:
    #   tracker-task:
    #     source: tracker-task
    #     intervalMs: 60000
    #     filters:
    #       state: open
    #       assignee: "you@yourorg.com"
    #       labels: ["ao"]
    #       limit: 100
    #     trigger:
    #       type: spawn-session

    # Files to symlink into workspaces
    # symlinks: [.env, .claude]

    # Commands to run after workspace creation
    # postCreate:
    #   - "pnpm install"

    # Agent-specific config
    # agentConfig:
    #   permissions: skip    # --dangerously-skip-permissions
    #   model: opus

    # Inline rules included in every agent prompt for this project
    # agentRules: |
    #   Always run tests before pushing.
    #   Use conventional commits (feat:, fix:, chore:).

    # Path to a rules file (relative to project path)
    # agentRulesFile: .agent-rules.md

    # Rules for the orchestrator agent (reserved for future use)
    # orchestratorRules: |
    #   Prefer to batch-spawn related issues together.

    # Per-project reaction overrides
    # reactions:
    #   approved-and-green:
    #     auto: true         # enable auto-merge for this project
    #     action: auto-merge
    #     mergeMethod: squash # optional: merge | squash | rebase
    #   tracker-comment:
    #     auto: true
    #     action: send-to-agent
    #     kind: reply         # any | tagged | reply
    #     # message: "New tracker comment received. Check context and update implementation."

# Notification channels
# notifiers:
#   slack:
#     plugin: slack
#     webhook: ${SLACK_WEBHOOK_URL}
#     channel: "#agent-updates"
#
#   telegram:
#     plugin: telegram
#     # token/chat can come from env (AO_TELEGRAM_BOT_TOKEN, AO_TELEGRAM_CHAT_ID)
#     # botToken: ${AO_TELEGRAM_BOT_TOKEN}
#     # chatId: ${AO_TELEGRAM_CHAT_ID}
#     # webhookSecret: ${AO_TELEGRAM_WEBHOOK_SECRET}
#     # pollingIntervalMs: 30000   # used only when Telegram webhook is not configured

# Shared services (optional)
# services:
#   transcriber:
#     binaryPath: /opt/whisper.cpp/build/bin/whisper-cli
#     modelPath: /opt/whisper.cpp/models/ggml-base.bin
#     # Optional advanced overrides (defaults are built-in):
#     # maxAudioBytes: 25000000

# Notification routing by priority
# notificationRouting:
#   urgent: [desktop, telegram]   # agent stuck, needs input, errored
#   action: [desktop, telegram]   # PR ready to merge
#   warning: [telegram]           # auto-fix failed
#   info: [telegram]              # summary, all done

# Trigger listeners — poll external sources and auto-trigger current spawn flow.
# Shared contract only exposes portable `filters`; no `jql` here by design.
# listeners:
#   tracker-broai:
#     source: tracker-task
#     projectId: int
#     intervalMs: 60000
#     mode: spawn              # spawn (default) | observe
#     filters:
#       state: open
#       assignee: "aleksey@intelas.com"
#       labels: ["BroAI"]
#       limit: 100
#     trigger:
#       type: spawn-session
#       # agent: codex            # optional agent override for auto-spawned sessions

# Reactions — auto-responses to events (these are the defaults)
# reactions:
#   ci-failed:
#     auto: true
#     action: send-to-agent
#     retries: 2
#     escalateAfter: 2
#
#   changes-requested:
#     auto: true
#     action: send-to-agent
#     escalateAfter: 30m
#
#   merge-conflicts:
#     auto: true
#     action: send-to-agent
#     message: "Your branch has merge conflicts. Rebase on the default branch, resolve conflicts, run tests, and push."
#     escalateAfter: 15m
#
#   tracker-comment:
#     auto: true
#     action: send-to-agent
#     kind: reply            # any | tagged | reply
#     # message: "A new tracker comment arrived. Review and address it."
#
#   approved-and-green:
#     auto: false              # set to true for auto-merge
#     action: notify           # use auto-merge to merge automatically
#     mergeMethod: squash      # optional for auto-merge: merge | squash | rebase
#     priority: action
#
#   agent-stuck:
#     threshold: 10m
#     action: notify
#     priority: urgent
