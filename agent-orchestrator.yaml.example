# Agent Orchestrator Configuration
# Copy to agent-orchestrator.yaml and customize.

# Where to store session metadata
dataDir: ~/.agent-orchestrator

# Where to create workspaces (git worktrees, clones)
worktreeDir: ~/.worktrees

# Web dashboard port
port: 3000

# Terminal server ports (defaults: 14800/14801 — chosen to avoid conflicts with dev tools)
# Override when running multiple dashboards to avoid EADDRINUSE
# terminalPort: 14800
# directTerminalPort: 14801

# Remote access (Tailscale)
# Short path for mobile HTTPS:
#   tailscale serve --bg 3000
# Then `ao dashboard` will print https://<your-node>.ts.net/
# remote:
#   tailscaleHost: auto  # prefer tailscale serve https URL, then MagicDNS/IP fallback

# Default plugins (these are the defaults — you can omit this section)
defaults:
  runtime: tmux # tmux | process | docker | kubernetes | ssh | e2b
  agent: claude-code # claude-code | codex | aider | goose | custom
  workspace: worktree # worktree | clone | copy
  notifiers: [desktop] # desktop | slack | telegram | discord | webhook | email

# Projects — at minimum, specify repo and path
projects:
  my-app:
    name: My App
    repo: org/my-app
    path: ~/my-app
    defaultBranch: main
    sessionPrefix: app

    # SCM configuration
    # scm:
    #   plugin: github
    #   prDraft: true        # true = draft PRs, false = ready PRs (default)

    # Issue tracker (defaults to github issues)
    # tracker:
    #   plugin: linear
    #   teamId: "your-team-id"

    # Jira tracker — per-project connection config
    # tracker:
    #   plugin: jira
    #   baseUrl: "https://myorg.atlassian.net"   # falls back to JIRA_URL / JIRA_HOST env var
    #   projectKey: "INT"                         # required for listIssues / createIssue
    #   email: "you@yourorg.com"                  # falls back to JIRA_EMAIL / JIRA_USER env var
    #   apiToken: "your-api-token"               # falls back to JIRA_API_TOKEN / JIRA_TOKEN env var (prefer env var over hardcoding)
    #   pollIntervalMs: 30000                    # comment poll interval (default: 60000); falls back to AO_JIRA_POLL_INTERVAL_MS
    #
    #   # Map Jira status names → system categories (open | in_progress | closed).
    #   # Used for color-coding and sorting in the dashboard tracker view.
    #   statusMapping:
    #     Backlog: open
    #     "On Hold": open
    #     "In Dev": in_progress
    #     "In Progress": in_progress
    #     "In Review": in_progress
    #     "Code Review": in_progress
    #     "In Prod": closed
    #     Done: closed
    #
    #   # Jira status names to hide from the dashboard tracker view entirely.
    #   ignoreStatuses:
    #     - "On Hold"
    #     - "Cancelled"

    # Per-project trigger listeners — tracker filters and auto-spawn config lives here.
    # Listeners are only supported under project config.
    # Canonical source is `tracker-task`.
    # `jql` is intentionally not supported here: it is Jira-specific and would break tracker portability.
    # Jira-specific query semantics belong inside the Jira tracker plugin, not the shared listener schema.
    # listeners:
    #   tracker-task:
    #     source: tracker-task
    #     intervalMs: 60000
    #     filters:
    #       state: open
    #       assignee: "you@yourorg.com"
    #       labels: ["ao"]
    #       limit: 100
    #     trigger:
    #       type: spawn-session

    # Files to symlink into workspaces
    # symlinks: [.env, .claude]

    # Commands to run after workspace creation
    # postCreate:
    #   - "pnpm install"

    # Agent-specific config
    # agentConfig:
    #   permissions: skip    # --dangerously-skip-permissions
    #   model: opus

    # Inline rules included in every agent prompt for this project
    # agentRules: |
    #   Always run tests before pushing.
    #   Use conventional commits (feat:, fix:, chore:).

    # Path to a rules file (relative to project path)
    # agentRulesFile: .agent-rules.md

    # Rules for the orchestrator agent (reserved for future use)
    # orchestratorRules: |
    #   Prefer to batch-spawn related issues together.

    # Pipeline — structured step-based workflow for agent sessions.
    # Each spawned session follows these steps sequentially.
    # The agent sees current step context and uses `ao done/fail/goto` to advance.
    #
    # pipeline:
    #   # Max total iterations across ALL steps before pipeline fails (default: none).
    #   # An "iteration" is one pipeline.tick() call — happens each poll cycle (~10s).
    #   maxIterations: 50
    #
    #   # What happens when a step fails: "fail" (default) | "skip" | "pause"
    #   #   fail  — pipeline stops, session marked failed
    #   #   skip  — skip the failed step, advance to next
    #   #   pause — pause pipeline, wait for human intervention (ao goto / ao done)
    #   recovery: fail
    #
    #   steps:
    #     # --- Step fields ---
    #
    #     # id (required) — unique step identifier, used in goto/when/output references
    #     # prompt        — instructions shown to the agent for this step
    #     # run           — shell command to execute (no agent involved, auto-completes)
    #     # channel       — human-in-the-loop step (e.g. "telegram"), waits for respond()
    #     # message       — display message for channel steps or send actions
    #     # options       — valid response choices for channel steps (e.g. ["APPROVE", "REJECT"])
    #     # allowText     — allow free-form text responses on channel steps (default: false)
    #     # when          — condition template; step is skipped if falsy
    #     #                 e.g. "{{steps.scoring.output.needsResearch}}"
    #     #                 Unresolved {{...}} = falsy (fail-closed)
    #     # goto          — after completion, jump to this step id instead of next
    #     # timeout       — max time for step before auto-fail (default: "1h")
    #     #                 Format: "30s", "5m", "1h"
    #     # maxIterations — max retries for this step before failing (overrides pipeline-level)
    #     #                 An "iteration" = one goto/restart of this specific step
    #     # recovery      — per-step override: "fail" | "skip" | "pause"
    #     # on            — event handlers (evaluated each tick):
    #     #                 Values: "done" | "fail" | "pause" | "send" | "goto <step-id>"
    #     #                 Or object: { send: "message", retries: N, goto: "step-id" }
    #     # all           — list of event names; step completes when ALL are true in same tick
    #
    #     - id: notify
    #       prompt: |
    #         Notify that the task has started.
    #         Run `ao done` when notification is sent.
    #       timeout: 5m
    #
    #     - id: implement
    #       prompt: |
    #         Implement the task. Run `ao done` when complete.
    #       maxIterations: 10
    #
    #     - id: review
    #       prompt: |
    #         Review the implementation. Run `ao done` if approved.
    #       maxIterations: 3
    #       recovery: skip
    #
    #     - id: open-pr
    #       prompt: |
    #         Open a PR. Run `ao done --output '{"pr_url": "<url>"}'`.
    #
    #     # Conditional step — only runs if previous step set the flag
    #     - id: design-review
    #       prompt: Review UI changes.
    #       when: "{{steps.implement.output.touchesUI}}"
    #       recovery: skip
    #
    #     # Shell command step — runs automatically, no agent
    #     - id: run-tests
    #       run: "pnpm test"
    #
    #     # Human-in-the-loop step — waits for external response
    #     - id: approval
    #       channel: telegram
    #       message: "Ready for review. Approve or reject?"
    #       options: ["APPROVE", "REJECT"]
    #       timeout: 30m

    # Per-project reaction overrides
    # reactions:
    #   approved-and-green:
    #     auto: true         # enable auto-merge for this project
    #     action: auto-merge
    #     mergeMethod: merge  # optional: merge | squash | rebase (default: merge)
    #   tracker-comment:
    #     auto: true
    #     action: send-to-agent
    #     kind: reply         # any | tagged | reply
    #     # message: "New tracker comment received. Check context and update implementation."

# Notification channels
# notifiers:
#   slack:
#     plugin: slack
#     webhook: ${SLACK_WEBHOOK_URL}
#     channel: "#agent-updates"
#
#   telegram:
#     plugin: telegram
#     # token/chat can come from env (AO_TELEGRAM_BOT_TOKEN, AO_TELEGRAM_CHAT_ID)
#     # botToken: ${AO_TELEGRAM_BOT_TOKEN}
#     # chatId: ${AO_TELEGRAM_CHAT_ID}
#     # webhookSecret: ${AO_TELEGRAM_WEBHOOK_SECRET}
#     # pollingIntervalMs: 30000   # used only when Telegram webhook is not configured

# Shared services (optional)
# services:
#   transcriber:
#     binaryPath: /opt/whisper.cpp/build/bin/whisper-cli
#     modelPath: /opt/whisper.cpp/models/ggml-base.bin
#     # Optional advanced overrides (defaults are built-in):
#     # maxAudioBytes: 25000000

# Notification routing by priority
# notificationRouting:
#   urgent: [desktop, telegram]   # agent stuck, needs input, errored
#   action: [desktop, telegram]   # PR ready to merge
#   warning: [telegram]           # auto-fix failed
#   info: [telegram]              # summary, all done

# Reactions — auto-responses to events (these are the defaults)
# reactions:
#   ci-failed:
#     auto: true
#     action: send-to-agent
#     retries: 2
#     escalateAfter: 2
#
#   changes-requested:
#     auto: true
#     action: send-to-agent
#     escalateAfter: 30m
#
#   merge-conflicts:
#     auto: true
#     action: send-to-agent
#     message: "Your branch has merge conflicts. Merge the default branch into your branch, resolve conflicts, run tests, and push. Do not rebase. Do not force push."
#     escalateAfter: 15m
#
#   tracker-comment:
#     auto: true
#     action: send-to-agent
#     kind: reply            # any | tagged | reply
#     # message: "A new tracker comment arrived. Review and address it."
#
#   approved-and-green:
#     auto: false              # set to true for auto-merge
#     action: notify           # use auto-merge to merge automatically
#     mergeMethod: merge        # optional for auto-merge: merge | squash | rebase (default: merge)
#     priority: action
#
#   agent-stuck:
#     threshold: 10m
#     action: notify
#     priority: urgent
