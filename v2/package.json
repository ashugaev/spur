{
  "name": "@shugaev/spur",
  "version": "0.0.0-managed",
  "publishConfig": {
    "access": "public"
  },
  "description": "Spur: lean v2 orchestrator with a local daemon, tmux sessions, and project workspaces",
  "license": "Apache-2.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashugaev/spur.git",
    "directory": "v2"
  },
  "homepage": "https://github.com/ashugaev/spur#readme",
  "type": "module",
  "bin": {
    "spur": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "deploy",
    "scripts/install-and-restart.sh",
    "scripts/npm-init.sh",
    "NOTICE",
    "spur.yaml.example",
    "tmux.conf"
  ],
  "scripts": {
    "build": "tsc && node bin/restart-daemon-if-running.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.md\" \"*.ts\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "test": "vitest run --config vitest.fast.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@grammyjs/runner": "2.0.3",
    "@playwright/mcp": "0.0.76",
    "commander": "^13.0.0",
    "croner": "^10.0.1",
    "grammy": "1.44.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
