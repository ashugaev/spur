{
  "name": "@composio/spur",
  "version": "0.1.0",
  "private": true,
  "description": "Spur: lean v2 orchestrator with a local daemon, tmux sessions, and git worktrees",
  "license": "MIT",
  "type": "module",
  "bin": {
    "spur": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "quality": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "test": "vitest run --config vitest.fast.config.ts",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^13.0.0",
    "croner": "^10.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
