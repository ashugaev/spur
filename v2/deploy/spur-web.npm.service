# Spur web UI systemd user unit for the npm-installed layout.
#
# Pairs with spur-daemon.npm.service. The web bundle ships inside the
# npm tarball under `<prefix>/lib/node_modules/@ashugaev/spur/web` and serves
# on 127.0.0.1. Install to ~/.config/systemd/user/spur-web.service.

[Unit]
Description=Spur web UI (npm install)
After=network.target spur-daemon.service
Requires=spur-daemon.service

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/node_modules/@ashugaev/spur/web
Environment=PORT=4311
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node %h/.local/lib/node_modules/@ashugaev/spur/web/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
