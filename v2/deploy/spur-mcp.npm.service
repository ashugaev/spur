[Unit]
Description=Spur MCP
After=network.target spur-daemon.service

[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SPUR_MCP_TUNNEL_ENV_FILE=%h/.spur/mcp-tunnel.env
ExecStart=/usr/bin/node %h/.local/lib/node_modules/@shugaev/spur/dist/cli.js mcp --http
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
