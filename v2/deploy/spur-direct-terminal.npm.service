# Direct terminal WebSocket server for npm-installed Spur web UI.
# Proxy /ws and /terminal-health to DIRECT_TERMINAL_BIND_PORT (default 14801).

[Unit]
Description=Spur direct terminal WebSocket (npm install)
After=network.target spur-daemon.service spur-web.service
Requires=spur-daemon.service

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/node_modules/@shugaev/spur/web
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DIRECT_TERMINAL_BIND_HOST=127.0.0.1
Environment=DIRECT_TERMINAL_BIND_PORT=14801
EnvironmentFile=-%h/.spur/daemon.env
ExecStartPre=/usr/bin/bash -c 'PTY=%h/.local/lib/node_modules/@shugaev/spur/web/node_modules/node-pty; test -f "$PTY/build/Release/pty.node" || (cd "$PTY" && npm run install)'
ExecStart=/usr/bin/node %h/.local/lib/node_modules/@shugaev/spur/web/dist-server/direct-terminal-ws.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
