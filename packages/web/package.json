{
  "name": "spur-web",
  "version": "0.1.0",
  "description": "UI dashboard for Spur",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/web-server.ts",
    "build": "rm -rf .next && next build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/web-server.js",
    "typecheck": "rm -rf .next && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf .next dist-server",
    "screenshot": "tsx e2e/screenshot.ts",
    "screenshot:install": "npx playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@xterm/addon-fit": "^0.11.0",
    "next": "^15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "node-gyp": "^12.2.0",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
