# Example for /etc/spur/daemon.env
# Copy values, then provision the real file on the host:
#   sudo install -d -m 0755 /etc/spur
#   sudo cp deploy/spur-daemon.env.example /etc/spur/daemon.env
#   sudo chown root:root /etc/spur/daemon.env
#   sudo chmod 0600 /etc/spur/daemon.env
# The spur-daemon systemd unit reads this via EnvironmentFile=.
# Leave empty if not using voice (Azure provider).
AZURE_OPENAI_API_KEY=
