# Spur daemon — systemd unit template
#
# The deploy script substitutes {{SPUR_ROOT}} and writes this file to
# /etc/systemd/system/spur-daemon.service. Secrets are provisioned
# out-of-band: create /etc/spur/daemon.env (mode 0600, owner root:root)
# containing AZURE_OPENAI_API_KEY=<value>. The unit pulls it via
# EnvironmentFile below.

[Unit]
Description=Spur daemon
After=network.target

[Service]
Type=simple
User=alek
WorkingDirectory={{SPUR_ROOT}}
Environment=HOME=/home/alek
Environment=PATH=/home/alek/.local/bin:/home/alek/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/spur/daemon.env
ExecStart=/usr/bin/node {{SPUR_ROOT}}/v2/dist/cli.js daemon start
Restart=always
RestartSec=3

# The daemon spawns tmux sessions (agent workspaces) that must outlive
# daemon restarts. The default KillMode=control-group sends SIGTERM to
# every process in the service cgroup — including tmux and the agents
# inside it. KillMode=process ensures only the daemon node process
# receives the stop signal. After restart the daemon re-discovers
# living sessions via applyConfig() → resumeSessionDelivery().
KillMode=process

[Install]
WantedBy=multi-user.target
