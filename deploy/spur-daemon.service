# Spur daemon systemd template
#
# Install to /etc/systemd/system/spur-daemon.service and replace {{...}}.

[Unit]
Description=Spur daemon
After=network.target

[Service]
Type=simple
User=alek
WorkingDirectory={{SPUR_ROOT}}
Environment=HOME=/home/alek
Environment=PATH=/home/alek/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=AZURE_OPENAI_API_KEY={{AZURE_OPENAI_API_KEY}}
ExecStart=/usr/bin/node {{SPUR_ROOT}}/v2/dist/cli.js daemon start
Restart=always
RestartSec=3

# Keep tmux agents alive across daemon restarts.
KillMode=process

[Install]
WantedBy=multi-user.target
