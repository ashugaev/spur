# Spur web UI systemd unit for npm-installed layout
#
# Pairs with deploy/spur-daemon.npm.service. Web bundle ships inside the npm
# tarball under `<prefix>/lib/node_modules/spur/web` and serves on 127.0.0.1.

[Unit]
Description=Spur web UI (npm install)
After=network.target spur-daemon-npm.service
Requires=spur-daemon-npm.service

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/node_modules/spur/web
Environment=PORT=4311
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node %h/.local/lib/node_modules/spur/web/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
