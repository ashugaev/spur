# Spur daemon systemd unit for npm-installed layout
#
# Use this when Spur is installed via `npm install -g spur` into a user prefix
# (for example `npm config set prefix ~/.local`). Copy to
# /etc/systemd/system/spur-daemon-npm.service or enable with `systemctl --user`.
# Store secrets in /etc/spur/daemon.env (mode 0600).

[Unit]
Description=Spur daemon (npm install)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=-/etc/spur/daemon.env
ExecStart=/usr/bin/node %h/.local/lib/node_modules/spur/dist/cli.js daemon start
Restart=always
RestartSec=3

# Keep tmux sessions alive across daemon restarts (see spur-daemon.service).
KillMode=process

[Install]
WantedBy=multi-user.target
